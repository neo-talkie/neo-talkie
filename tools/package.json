{
  "name": "@neotalkie/tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "simulator": "node simulator/server.mjs",
    "simulator:test": "node --test simulator/tests/*.test.mjs",
    "ui:generate": "node ui/generate.mjs && node simulator/scripts/catalog.mjs",
    "ui:parity": "node ui/parity.mjs",
    "ui:check": "node ui/generate.mjs --check && node simulator/scripts/catalog.mjs --check && node ui/guard.mjs && npm run simulator:test && npm run ui:parity && node ui/negative.mjs",
    "ui:visual": "node ui/visual.mjs --output ../data/ui-regression/latest",
    "ui:accept": "node ui/guard.mjs --accept",
    "check:public": "python3 scripts/check-public.py",
    "test": "npm run ui:check"
  },
  "devDependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0"
  }
}
